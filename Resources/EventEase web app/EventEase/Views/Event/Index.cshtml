@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
    Event 
*@
@{
}

@model IEnumerable<EventEase.Models.Event>

<h2>Employees</h2>

<p>
    <a asp-action="Create">Create New Booking</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>EventID</th>
            <th>E_Date</th>
            <th>E_Time</th>
            <th>Description</th>
            <th>Capacity</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>

                <td>@item.EventID</td>
                <td>@item.E_Date</td>
                <td>@item.E_Time</td>
                <td>@item.E_Description</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.EventID">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.EventID">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.EventID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

